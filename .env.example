# Supabase project connection (public — safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER used in a request path (see ARCHITECTURE.md §9).
# Reserved for offline admin/migration scripts only, if ever needed.
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID (public — safe to expose to the
# browser, same as the Supabase URL/anon key above). Rendered via
# @next/third-parties/google in components/analytics/google-analytics.tsx,
# which also excludes /create and /w/[token]/* from pageview tracking —
# see that file for why. Leave empty to run with no analytics at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only needed once Phase 7 (AI-assisted question/option suggestions) is built.
# ANTHROPIC_API_KEY=

# Local integration-test Postgres (see tests/integration/setup). Not used by
# the app itself — only by `pnpm test:integration`. Defaults are fine locally.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres
