// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`36 Questions: frozen as approved > B's invitation page for a 36 Questions link 1`] = `"<div class="font font wl-create"><header class="create-header"><a class="create-header__logo" href="/"><svg class="create-header__logo-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="_R_l_" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="var(--wl-lavender)"></stop><stop offset="100%" stop-color="var(--wl-blue)"></stop></linearGradient></defs><circle class="logo-mark__ping" cx="12" cy="12" r="9" stroke="url(#_R_l_)" stroke-width="1.5"></circle><circle cx="12" cy="12" r="9" stroke="url(#_R_l_)" stroke-width="2.25"></circle><circle cx="12" cy="12" r="3.75" fill="currentColor"></circle></svg><span>Sameeeish</span></a><a class="create-header__back" href="/play">← Back</a></header><main class="create-shell invite-shell"><div class="invite-intro"><p class="invite-intro__eyebrow">You&#x27;ve been invited</p><h1 class="invite-intro__heading">Ready for a real conversation?</h1><svg class="invite-intro__motif" viewBox="0 0 260 56" fill="none" aria-hidden="true"><path d="M18 36c40-28 80-28 112 0s72 28 112 0" stroke="var(--wl-muted)" stroke-width="1.5" stroke-dasharray="5 6"></path><circle cx="18" cy="36" r="9" fill="#ffffff" stroke="var(--wl-lavender)" stroke-width="4"></circle><circle cx="18" cy="36" r="3.5" fill="var(--wl-ink)"></circle><circle cx="242" cy="36" r="10" fill="#ffffff" stroke="var(--wl-blue)" stroke-width="4"></circle><path d="M254 19.5l1.7 4 4 1.7-4 1.7-1.7 4-1.7-4-4-1.7 4-1.7z" fill="var(--wl-blue)"></path></svg><p class="invite-intro__text">Alex has answered 36 questions, from light to meaningful, in three stages. Answer the same ones in your own words — once you&#x27;ve both finished, you&#x27;ll read each other&#x27;s answers side by side.</p></div><section class="invite-card"><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="token" value="0123456789abcdef0123456789abcdef"/><div class="create-field"><label for="join-alias" class="invite-card__label">What&#x27;s your name?</label><input id="join-alias" class="create-input" type="text" placeholder="Your name" required="" maxLength="60" name="alias"/></div><button type="submit" class="invite-button">Start answering</button></form></section></main><div class="tsq-embed"><article class="landing-section landing-how tsq-page"><header class="tsq-hero"><div class="tsq-hero__shapes" aria-hidden="true"><span class="tsq-hero__shape tsq-hero__shape--pink"></span><span class="tsq-hero__shape tsq-hero__shape--lavender"></span></div><div class="tsq-hero__content"><p class="tsq-hero__eyebrow">A guided conversation for two</p><h2 class="tsq-hero__title">36 Questions to Fall in Love</h2><p class="tsq-hero__text">Some conversations take years to get to. This one gets there on purpose: 36 questions in three stages, starting with the easy things and working gently toward the ones that matter. Each of you answers in your own words, then you read both sets of answers side by side.</p><div class="tsq-hero__cta"><a href="#join-alias" class="landing-button landing-button--primary landing-button--play">Join the conversation <span aria-hidden="true">↑</span></a><p class="tsq-hero__note">Free · No sign-up · Answers stay private</p></div></div></header><section class="tsq-section" aria-labelledby="tsq-origins"><h2 id="tsq-origins" class="tsq-section__heading">Where the idea comes from</h2><p class="tsq-section__text">In 1997, psychologist Arthur Aron and his colleagues published a study in <cite>Personality and Social Psychology Bulletin</cite> describing a way to build a sense of closeness between two strangers. Pairs took turns asking each other 36 questions, split into three sets that grew more personal, over about 45 minutes. Afterwards, they reported feeling closer to each other than pairs who had spent the same time on small talk.</p><p class="tsq-section__text">The idea reached a much wider audience in 2015, when writer Mandy Len Catron described trying the questions on a date in the <cite>New York Times</cite> “Modern Love” column, under the headline “To Fall in Love With Anyone, Do This.” That&#x27;s where the “fall in love” name comes from.</p><p class="tsq-section__text">Worth knowing: the study measured closeness after a single conversation, not love. The questions here are our own, written for Sameeeish around the same idea — open up a little more with each stage. They aren&#x27;t the questions from the study, and there&#x27;s no score at the end.</p></section><section class="tsq-section" aria-labelledby="tsq-how"><h2 id="tsq-how" class="tsq-section__heading">How to play</h2><ol class="tsq-steps"><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">1</span><div><h3 class="tsq-step__title">Start the experience</h3><p class="tsq-step__text">You&#x27;ll get the 36 questions one at a time, in three stages of 12. No account and no sign-up.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">2</span><div><h3 class="tsq-step__title">Answer in your own words</h3><p class="tsq-step__text">Take your time. Each answer saves as you go, and you can go back and change any of them before you finish.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">3</span><div><h3 class="tsq-step__title">Send your private link</h3><p class="tsq-step__text">When you&#x27;ve answered all 36, add your name and share the link with the person you&#x27;re doing this with.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">4</span><div><h3 class="tsq-step__title">They answer the same questions</h3><p class="tsq-step__text">Same questions, same order. Neither of you can see the other&#x27;s answers until you&#x27;ve both finished.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">5</span><div><h3 class="tsq-step__title">Read your conversation together</h3><p class="tsq-step__text">Both answers to every question, side by side, stage by stage. Then put the phones down and talk.</p></div></li></ol></section><section class="tsq-section" aria-labelledby="tsq-stages"><h2 id="tsq-stages" class="tsq-section__heading">The three stages</h2><p class="tsq-section__text">Every conversation uses the same 36 questions in the same order, so you both answer exactly what the other one did.</p><div class="tsq-stages"><section class="tsq-stage tsq-stage--lavender" aria-labelledby="tsq-stage-1"><p class="tsq-stage__eyebrow">Stage 1</p><h3 id="tsq-stage-1" class="tsq-stage__title">Building a Connection</h3><p class="tsq-stage__text">Light, personal questions to get comfortable — the places, habits, and small joys that make you who you are.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="1"><li>What&#x27;s a small, ordinary thing that reliably puts you in a good mood?</li><li>Which place from your childhood can you still picture in detail?</li><li>What&#x27;s a skill or hobby you picked up that surprised the people around you?</li><li>What does a really good weekend morning look like for you?</li><li>What&#x27;s a book, film, or song that arrived in your life at exactly the right moment?</li><li>If you could spend a year living in another city, where would you go and why?</li><li>What&#x27;s something you&#x27;re curious about right now and would love to learn more about?</li><li>Who was the first friend you remember choosing for yourself, and what drew you to them?</li><li>What&#x27;s a compliment you received that you still think about?</li><li>What&#x27;s a tradition, big or small, that you&#x27;d like to keep for the rest of your life?</li><li>What kind of moments make you lose track of time?</li><li>What&#x27;s something about where you grew up that you only appreciated after you left?</li></ol></details></section><section class="tsq-stage tsq-stage--pink" aria-labelledby="tsq-stage-2"><p class="tsq-stage__eyebrow">Stage 2</p><h3 id="tsq-stage-2" class="tsq-stage__title">Going Deeper</h3><p class="tsq-stage__text">Experiences, values, and memories — the moments and beliefs that have shaped you.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="13"><li>What&#x27;s a decision you made that changed the direction of your life?</li><li>When did you last feel truly proud of yourself, and why did that moment matter?</li><li>Which value do you try hardest to live by, even when it&#x27;s inconvenient?</li><li>What&#x27;s a lesson you learned the hard way that you&#x27;re now grateful for?</li><li>Who taught you the most about how to treat other people, and how did they teach you?</li><li>What&#x27;s something you believed strongly a few years ago that you see differently now?</li><li>What helps you feel at home when you&#x27;re somewhere unfamiliar?</li><li>What&#x27;s a fear you&#x27;ve grown out of, and what helped you move past it?</li><li>When you&#x27;re going through something difficult, what do you most need from the people around you?</li><li>When did a stranger&#x27;s kindness stay with you long after the moment passed?</li><li>What part of your everyday life would you protect no matter how busy you got?</li><li>What do you hope people feel after spending time with you?</li></ol></details></section><section class="tsq-stage tsq-stage--peach" aria-labelledby="tsq-stage-3"><p class="tsq-stage__eyebrow">Stage 3</p><h3 id="tsq-stage-3" class="tsq-stage__title">Growing Closer</h3><p class="tsq-stage__text">Feelings, hopes, and what you see in each other — the questions that ask for a little more openness.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="25"><li>What&#x27;s something you rarely say out loud but often feel?</li><li>When do you feel most like yourself around another person?</li><li>What&#x27;s a part of yourself you&#x27;re still learning to accept?</li><li>What&#x27;s a hope for your future that you don&#x27;t often share?</li><li>How do you usually show someone you care, and how do you most like to be cared for?</li><li>What&#x27;s a question you wish more people asked you?</li><li>What makes it hard for you to let people in, and what makes it easier?</li><li>What does feeling truly understood look like for you?</li><li>When did you last feel really close to someone, and what made it feel that way?</li><li>What&#x27;s something you appreciate about the person you&#x27;re answering these questions with?</li><li>What&#x27;s something you&#x27;d love the two of you to experience together?</li><li>What&#x27;s one thing you&#x27;d like them to know about you that hasn&#x27;t come up yet?</li></ol></details></section></div></section><section class="tsq-cta" aria-labelledby="tsq-cta-heading"><h2 id="tsq-cta-heading" class="tsq-cta__heading">Ready when you are</h2><p class="tsq-cta__text">Add your name at the top of this page to start answering. You&#x27;ll read each other&#x27;s answers once you&#x27;ve both finished.</p><a href="#join-alias" class="landing-button landing-button--primary landing-button--play">Add your name above <span aria-hidden="true">↑</span></a></section><section class="tsq-section" aria-labelledby="tsq-faq"><h2 id="tsq-faq" class="tsq-section__heading">Questions people ask</h2><div class="faq-accordion"><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-0"><span class="faq-item__question">Do the 36 questions really make people fall in love?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-0" class="faq-item__answer faq-item__answer--lavender" hidden="">No list of questions can promise that. The original study found that pairs of strangers felt closer after working through its questions than pairs who spent the same time on small talk — it didn&#x27;t test whether anyone fell in love. Think of it as a structured way into a conversation you might not otherwise have.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-1"><span class="faq-item__question">Are these the questions from the original study?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-1" class="faq-item__answer faq-item__answer--lavender" hidden="">No. These are original questions written for Sameeeish, built on the same idea: start light and go a little deeper with each stage. If you&#x27;d like to read the research version, look up Aron and colleagues&#x27; 1997 paper, “The Experimental Generation of Interpersonal Closeness.”</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-2"><span class="faq-item__question">How long does it take?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-2" class="faq-item__answer faq-item__answer--lavender" hidden="">In the original study, pairs had about 45 minutes for all three sets of questions, asked out loud. Writing your answers usually takes a bit longer, so many people spread it over an evening. Your answers save as you go, so you can stop and pick up where you left off on the same browser.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-3"><span class="faq-item__question">Is it only for couples?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-3" class="faq-item__answer faq-item__answer--lavender" hidden="">It sits in our Dating &amp; Couples section and works just as well for a first date as for a long relationship. But the questions suit any two people who want to know each other better, close friends included.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-4"><span class="faq-item__question">Who can see our answers?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-4" class="faq-item__answer faq-item__answer--lavender" hidden="">Only the two of you. Your answers are tied to your private link and the browser you answered on, and neither of you can see the other&#x27;s answers until you&#x27;ve both finished. Nothing you write appears on this page or anywhere public, and there&#x27;s no account to create.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-5"><span class="faq-item__question">Is there a score at the end?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-5" class="faq-item__answer faq-item__answer--lavender" hidden="">No. This isn&#x27;t a compatibility test, so there&#x27;s no percentage, rating, or verdict. What you get is your conversation: both of your answers to every question, side by side.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-6"><span class="faq-item__question">Can we do it together in person?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-6" class="faq-item__answer faq-item__answer--lavender" hidden="">Yes. One easy way: each of you answers on your own phone, then sit down together with your finished conversation and go through it question by question, reading your answers out loud and talking about them.</p></div></div></section><nav class="tsq-section tsq-related" aria-labelledby="tsq-related"><h2 id="tsq-related" class="tsq-section__heading">More for the two of you</h2><ul class="tsq-related__list"><li><a class="tsq-related__card tsq-related__card--lavender" target="_blank" rel="noopener noreferrer" href="/play/dating-couples/getting-to-know-each-other-questions"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M14 36c14-18 28-18 34 0s20 18 34 0" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 5"></path><circle cx="14" cy="36" r="8" fill="#ffffff" stroke="var(--wl-lavender)" stroke-width="4"></circle><circle cx="14" cy="36" r="3" fill="var(--wl-ink)"></circle><circle cx="82" cy="36" r="8" fill="#ffffff" stroke="var(--wl-blue)" stroke-width="4"></circle><circle cx="82" cy="36" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Discovery &amp; Conversation</span><span class="tsq-related__title">Getting to know each other questions</span><span class="tsq-related__text">Lighter questions for new couples and early dates.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--peach" target="_blank" rel="noopener noreferrer" href="/play/dating-couples/date-night"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" fill="#ffffff"></path><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></path><path d="M72 12l1.5 3.5 3.5 1.5-3.5 1.5L72 22l-1.5-3.5L67 17l3.5-1.5z" fill="var(--wl-pink)"></path><path d="M80 30l1 2.4 2.4 1-2.4 1-1 2.4-1-2.4-2.4-1 2.4-1z" fill="var(--wl-ink)" opacity="0.5"></path><circle cx="20" cy="18" r="2" fill="var(--wl-pink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Conversation Starters</span><span class="tsq-related__title">Date Night</span><span class="tsq-related__text">Conversation starters to pick from, one at a time.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--mint" target="_blank" rel="noopener noreferrer" href="/play/dating-couples"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><circle cx="38" cy="28" r="18" fill="#ffffff" fill-opacity="0.7"></circle><circle cx="58" cy="28" r="18" fill="var(--wl-blue)" fill-opacity="0.75"></circle><circle cx="38" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="58" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="48" cy="28" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Compatibility Quiz</span><span class="tsq-related__title">Are we on the same page?</span><span class="tsq-related__text">A compatibility quiz to see where you align — and every other couples experience.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li></ul></nav></article></div></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var c=a.target,d=a.submitter,e=c.action,b=d;if(d){var f=d.getAttribute("formAction");null!=f&&(e=f,b=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===e&&(a.preventDefault(),b?(a=document.createElement("input"),a.name=b.name,a.value=b.value,b.parentNode.insertBefore(a,b),b=new FormData(c),a.parentNode.removeChild(a)):b=new FormData(c),a=c.ownerDocument||c,(a.$$reactFormReplay=a.$$reactFormReplay||[]).push(c,d,b))}});</script>"`;

exports[`36 Questions: frozen as approved > experience content in B's invitation context 1`] = `"<article class="landing-section landing-how tsq-page"><header class="tsq-hero"><div class="tsq-hero__shapes" aria-hidden="true"><span class="tsq-hero__shape tsq-hero__shape--pink"></span><span class="tsq-hero__shape tsq-hero__shape--lavender"></span></div><div class="tsq-hero__content"><p class="tsq-hero__eyebrow">A guided conversation for two</p><h2 class="tsq-hero__title">36 Questions to Fall in Love</h2><p class="tsq-hero__text">Some conversations take years to get to. This one gets there on purpose: 36 questions in three stages, starting with the easy things and working gently toward the ones that matter. Each of you answers in your own words, then you read both sets of answers side by side.</p><div class="tsq-hero__cta"><a href="#join-alias" class="landing-button landing-button--primary landing-button--play">Join the conversation <span aria-hidden="true">↑</span></a><p class="tsq-hero__note">Free · No sign-up · Answers stay private</p></div></div></header><section class="tsq-section" aria-labelledby="tsq-origins"><h2 id="tsq-origins" class="tsq-section__heading">Where the idea comes from</h2><p class="tsq-section__text">In 1997, psychologist Arthur Aron and his colleagues published a study in <cite>Personality and Social Psychology Bulletin</cite> describing a way to build a sense of closeness between two strangers. Pairs took turns asking each other 36 questions, split into three sets that grew more personal, over about 45 minutes. Afterwards, they reported feeling closer to each other than pairs who had spent the same time on small talk.</p><p class="tsq-section__text">The idea reached a much wider audience in 2015, when writer Mandy Len Catron described trying the questions on a date in the <cite>New York Times</cite> “Modern Love” column, under the headline “To Fall in Love With Anyone, Do This.” That&#x27;s where the “fall in love” name comes from.</p><p class="tsq-section__text">Worth knowing: the study measured closeness after a single conversation, not love. The questions here are our own, written for Sameeeish around the same idea — open up a little more with each stage. They aren&#x27;t the questions from the study, and there&#x27;s no score at the end.</p></section><section class="tsq-section" aria-labelledby="tsq-how"><h2 id="tsq-how" class="tsq-section__heading">How to play</h2><ol class="tsq-steps"><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">1</span><div><h3 class="tsq-step__title">Start the experience</h3><p class="tsq-step__text">You&#x27;ll get the 36 questions one at a time, in three stages of 12. No account and no sign-up.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">2</span><div><h3 class="tsq-step__title">Answer in your own words</h3><p class="tsq-step__text">Take your time. Each answer saves as you go, and you can go back and change any of them before you finish.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">3</span><div><h3 class="tsq-step__title">Send your private link</h3><p class="tsq-step__text">When you&#x27;ve answered all 36, add your name and share the link with the person you&#x27;re doing this with.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">4</span><div><h3 class="tsq-step__title">They answer the same questions</h3><p class="tsq-step__text">Same questions, same order. Neither of you can see the other&#x27;s answers until you&#x27;ve both finished.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">5</span><div><h3 class="tsq-step__title">Read your conversation together</h3><p class="tsq-step__text">Both answers to every question, side by side, stage by stage. Then put the phones down and talk.</p></div></li></ol></section><section class="tsq-section" aria-labelledby="tsq-stages"><h2 id="tsq-stages" class="tsq-section__heading">The three stages</h2><p class="tsq-section__text">Every conversation uses the same 36 questions in the same order, so you both answer exactly what the other one did.</p><div class="tsq-stages"><section class="tsq-stage tsq-stage--lavender" aria-labelledby="tsq-stage-1"><p class="tsq-stage__eyebrow">Stage 1</p><h3 id="tsq-stage-1" class="tsq-stage__title">Building a Connection</h3><p class="tsq-stage__text">Light, personal questions to get comfortable — the places, habits, and small joys that make you who you are.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="1"><li>What&#x27;s a small, ordinary thing that reliably puts you in a good mood?</li><li>Which place from your childhood can you still picture in detail?</li><li>What&#x27;s a skill or hobby you picked up that surprised the people around you?</li><li>What does a really good weekend morning look like for you?</li><li>What&#x27;s a book, film, or song that arrived in your life at exactly the right moment?</li><li>If you could spend a year living in another city, where would you go and why?</li><li>What&#x27;s something you&#x27;re curious about right now and would love to learn more about?</li><li>Who was the first friend you remember choosing for yourself, and what drew you to them?</li><li>What&#x27;s a compliment you received that you still think about?</li><li>What&#x27;s a tradition, big or small, that you&#x27;d like to keep for the rest of your life?</li><li>What kind of moments make you lose track of time?</li><li>What&#x27;s something about where you grew up that you only appreciated after you left?</li></ol></details></section><section class="tsq-stage tsq-stage--pink" aria-labelledby="tsq-stage-2"><p class="tsq-stage__eyebrow">Stage 2</p><h3 id="tsq-stage-2" class="tsq-stage__title">Going Deeper</h3><p class="tsq-stage__text">Experiences, values, and memories — the moments and beliefs that have shaped you.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="13"><li>What&#x27;s a decision you made that changed the direction of your life?</li><li>When did you last feel truly proud of yourself, and why did that moment matter?</li><li>Which value do you try hardest to live by, even when it&#x27;s inconvenient?</li><li>What&#x27;s a lesson you learned the hard way that you&#x27;re now grateful for?</li><li>Who taught you the most about how to treat other people, and how did they teach you?</li><li>What&#x27;s something you believed strongly a few years ago that you see differently now?</li><li>What helps you feel at home when you&#x27;re somewhere unfamiliar?</li><li>What&#x27;s a fear you&#x27;ve grown out of, and what helped you move past it?</li><li>When you&#x27;re going through something difficult, what do you most need from the people around you?</li><li>When did a stranger&#x27;s kindness stay with you long after the moment passed?</li><li>What part of your everyday life would you protect no matter how busy you got?</li><li>What do you hope people feel after spending time with you?</li></ol></details></section><section class="tsq-stage tsq-stage--peach" aria-labelledby="tsq-stage-3"><p class="tsq-stage__eyebrow">Stage 3</p><h3 id="tsq-stage-3" class="tsq-stage__title">Growing Closer</h3><p class="tsq-stage__text">Feelings, hopes, and what you see in each other — the questions that ask for a little more openness.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="25"><li>What&#x27;s something you rarely say out loud but often feel?</li><li>When do you feel most like yourself around another person?</li><li>What&#x27;s a part of yourself you&#x27;re still learning to accept?</li><li>What&#x27;s a hope for your future that you don&#x27;t often share?</li><li>How do you usually show someone you care, and how do you most like to be cared for?</li><li>What&#x27;s a question you wish more people asked you?</li><li>What makes it hard for you to let people in, and what makes it easier?</li><li>What does feeling truly understood look like for you?</li><li>When did you last feel really close to someone, and what made it feel that way?</li><li>What&#x27;s something you appreciate about the person you&#x27;re answering these questions with?</li><li>What&#x27;s something you&#x27;d love the two of you to experience together?</li><li>What&#x27;s one thing you&#x27;d like them to know about you that hasn&#x27;t come up yet?</li></ol></details></section></div></section><section class="tsq-cta" aria-labelledby="tsq-cta-heading"><h2 id="tsq-cta-heading" class="tsq-cta__heading">Ready when you are</h2><p class="tsq-cta__text">Add your name at the top of this page to start answering. You&#x27;ll read each other&#x27;s answers once you&#x27;ve both finished.</p><a href="#join-alias" class="landing-button landing-button--primary landing-button--play">Add your name above <span aria-hidden="true">↑</span></a></section><section class="tsq-section" aria-labelledby="tsq-faq"><h2 id="tsq-faq" class="tsq-section__heading">Questions people ask</h2><div class="faq-accordion"><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-0"><span class="faq-item__question">Do the 36 questions really make people fall in love?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-0" class="faq-item__answer faq-item__answer--lavender" hidden="">No list of questions can promise that. The original study found that pairs of strangers felt closer after working through its questions than pairs who spent the same time on small talk — it didn&#x27;t test whether anyone fell in love. Think of it as a structured way into a conversation you might not otherwise have.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-1"><span class="faq-item__question">Are these the questions from the original study?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-1" class="faq-item__answer faq-item__answer--lavender" hidden="">No. These are original questions written for Sameeeish, built on the same idea: start light and go a little deeper with each stage. If you&#x27;d like to read the research version, look up Aron and colleagues&#x27; 1997 paper, “The Experimental Generation of Interpersonal Closeness.”</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-2"><span class="faq-item__question">How long does it take?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-2" class="faq-item__answer faq-item__answer--lavender" hidden="">In the original study, pairs had about 45 minutes for all three sets of questions, asked out loud. Writing your answers usually takes a bit longer, so many people spread it over an evening. Your answers save as you go, so you can stop and pick up where you left off on the same browser.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-3"><span class="faq-item__question">Is it only for couples?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-3" class="faq-item__answer faq-item__answer--lavender" hidden="">It sits in our Dating &amp; Couples section and works just as well for a first date as for a long relationship. But the questions suit any two people who want to know each other better, close friends included.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-4"><span class="faq-item__question">Who can see our answers?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-4" class="faq-item__answer faq-item__answer--lavender" hidden="">Only the two of you. Your answers are tied to your private link and the browser you answered on, and neither of you can see the other&#x27;s answers until you&#x27;ve both finished. Nothing you write appears on this page or anywhere public, and there&#x27;s no account to create.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-5"><span class="faq-item__question">Is there a score at the end?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-5" class="faq-item__answer faq-item__answer--lavender" hidden="">No. This isn&#x27;t a compatibility test, so there&#x27;s no percentage, rating, or verdict. What you get is your conversation: both of your answers to every question, side by side.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-6"><span class="faq-item__question">Can we do it together in person?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-6" class="faq-item__answer faq-item__answer--lavender" hidden="">Yes. One easy way: each of you answers on your own phone, then sit down together with your finished conversation and go through it question by question, reading your answers out loud and talking about them.</p></div></div></section><nav class="tsq-section tsq-related" aria-labelledby="tsq-related"><h2 id="tsq-related" class="tsq-section__heading">More for the two of you</h2><ul class="tsq-related__list"><li><a class="tsq-related__card tsq-related__card--lavender" target="_blank" rel="noopener noreferrer" href="/play/dating-couples/getting-to-know-each-other-questions"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M14 36c14-18 28-18 34 0s20 18 34 0" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 5"></path><circle cx="14" cy="36" r="8" fill="#ffffff" stroke="var(--wl-lavender)" stroke-width="4"></circle><circle cx="14" cy="36" r="3" fill="var(--wl-ink)"></circle><circle cx="82" cy="36" r="8" fill="#ffffff" stroke="var(--wl-blue)" stroke-width="4"></circle><circle cx="82" cy="36" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Discovery &amp; Conversation</span><span class="tsq-related__title">Getting to know each other questions</span><span class="tsq-related__text">Lighter questions for new couples and early dates.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--peach" target="_blank" rel="noopener noreferrer" href="/play/dating-couples/date-night"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" fill="#ffffff"></path><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></path><path d="M72 12l1.5 3.5 3.5 1.5-3.5 1.5L72 22l-1.5-3.5L67 17l3.5-1.5z" fill="var(--wl-pink)"></path><path d="M80 30l1 2.4 2.4 1-2.4 1-1 2.4-1-2.4-2.4-1 2.4-1z" fill="var(--wl-ink)" opacity="0.5"></path><circle cx="20" cy="18" r="2" fill="var(--wl-pink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Conversation Starters</span><span class="tsq-related__title">Date Night</span><span class="tsq-related__text">Conversation starters to pick from, one at a time.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--mint" target="_blank" rel="noopener noreferrer" href="/play/dating-couples"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><circle cx="38" cy="28" r="18" fill="#ffffff" fill-opacity="0.7"></circle><circle cx="58" cy="28" r="18" fill="var(--wl-blue)" fill-opacity="0.75"></circle><circle cx="38" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="58" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="48" cy="28" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Compatibility Quiz</span><span class="tsq-related__title">Are we on the same page?</span><span class="tsq-related__text">A compatibility quiz to see where you align — and every other couples experience.</span><span class="tsq-related__go">Explore <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span></span></a></li></ul></nav></article>"`;

exports[`36 Questions: frozen as approved > landing page HTML 1`] = `"<div class="font font landing landing--internal"><header class="landing-header"><div class="landing-header__inner"><a class="landing-logo" href="/"><svg class="landing-logo__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="_R_l_" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="var(--wl-lavender)"></stop><stop offset="100%" stop-color="var(--wl-blue)"></stop></linearGradient></defs><circle class="logo-mark__ping" cx="12" cy="12" r="9" stroke="url(#_R_l_)" stroke-width="1.5"></circle><circle cx="12" cy="12" r="9" stroke="url(#_R_l_)" stroke-width="2.25"></circle><circle cx="12" cy="12" r="3.75" fill="currentColor"></circle></svg><span>Sameeeish</span></a><nav class="landing-nav" aria-label="Landing sections"><a href="/how-it-works">How it works</a><a href="/ways-to-play">Ways to play</a><a href="/faq">FAQ</a></nav><a class="landing-header__cta" href="/play">Start playing</a></div></header><main><div class="landing-back-link-row"><a class="landing-back-link" href="/play/dating-couples">← Back</a></div><article class="landing-section landing-how tsq-page"><header class="tsq-hero"><div class="tsq-hero__shapes" aria-hidden="true"><span class="tsq-hero__shape tsq-hero__shape--pink"></span><span class="tsq-hero__shape tsq-hero__shape--lavender"></span></div><div class="tsq-hero__content"><p class="tsq-hero__eyebrow">A guided conversation for two</p><h1 class="tsq-hero__title">36 Questions to Fall in Love</h1><p class="tsq-hero__text">Some conversations take years to get to. This one gets there on purpose: 36 questions in three stages, starting with the easy things and working gently toward the ones that matter. Each of you answers in your own words, then you read both sets of answers side by side.</p><div class="tsq-hero__cta"><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="gameId" value="36-questions-to-fall-in-love"/><button type="submit" class="landing-button landing-button--primary landing-button--play">Start the experience <span aria-hidden="true">→</span></button></form><p class="tsq-hero__note">Free · No sign-up · Answers stay private</p></div></div></header><section class="tsq-section" aria-labelledby="tsq-origins"><h2 id="tsq-origins" class="tsq-section__heading">Where the idea comes from</h2><p class="tsq-section__text">In 1997, psychologist Arthur Aron and his colleagues published a study in <cite>Personality and Social Psychology Bulletin</cite> describing a way to build a sense of closeness between two strangers. Pairs took turns asking each other 36 questions, split into three sets that grew more personal, over about 45 minutes. Afterwards, they reported feeling closer to each other than pairs who had spent the same time on small talk.</p><p class="tsq-section__text">The idea reached a much wider audience in 2015, when writer Mandy Len Catron described trying the questions on a date in the <cite>New York Times</cite> “Modern Love” column, under the headline “To Fall in Love With Anyone, Do This.” That&#x27;s where the “fall in love” name comes from.</p><p class="tsq-section__text">Worth knowing: the study measured closeness after a single conversation, not love. The questions here are our own, written for Sameeeish around the same idea — open up a little more with each stage. They aren&#x27;t the questions from the study, and there&#x27;s no score at the end.</p></section><section class="tsq-section" aria-labelledby="tsq-how"><h2 id="tsq-how" class="tsq-section__heading">How to play</h2><ol class="tsq-steps"><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">1</span><div><h3 class="tsq-step__title">Start the experience</h3><p class="tsq-step__text">You&#x27;ll get the 36 questions one at a time, in three stages of 12. No account and no sign-up.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">2</span><div><h3 class="tsq-step__title">Answer in your own words</h3><p class="tsq-step__text">Take your time. Each answer saves as you go, and you can go back and change any of them before you finish.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">3</span><div><h3 class="tsq-step__title">Send your private link</h3><p class="tsq-step__text">When you&#x27;ve answered all 36, add your name and share the link with the person you&#x27;re doing this with.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">4</span><div><h3 class="tsq-step__title">They answer the same questions</h3><p class="tsq-step__text">Same questions, same order. Neither of you can see the other&#x27;s answers until you&#x27;ve both finished.</p></div></li><li class="tsq-step"><span class="tsq-step__number" aria-hidden="true">5</span><div><h3 class="tsq-step__title">Read your conversation together</h3><p class="tsq-step__text">Both answers to every question, side by side, stage by stage. Then put the phones down and talk.</p></div></li></ol></section><section class="tsq-section" aria-labelledby="tsq-stages"><h2 id="tsq-stages" class="tsq-section__heading">The three stages</h2><p class="tsq-section__text">Every conversation uses the same 36 questions in the same order, so you both answer exactly what the other one did.</p><div class="tsq-stages"><section class="tsq-stage tsq-stage--lavender" aria-labelledby="tsq-stage-1"><p class="tsq-stage__eyebrow">Stage 1</p><h3 id="tsq-stage-1" class="tsq-stage__title">Building a Connection</h3><p class="tsq-stage__text">Light, personal questions to get comfortable — the places, habits, and small joys that make you who you are.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="1"><li>What&#x27;s a small, ordinary thing that reliably puts you in a good mood?</li><li>Which place from your childhood can you still picture in detail?</li><li>What&#x27;s a skill or hobby you picked up that surprised the people around you?</li><li>What does a really good weekend morning look like for you?</li><li>What&#x27;s a book, film, or song that arrived in your life at exactly the right moment?</li><li>If you could spend a year living in another city, where would you go and why?</li><li>What&#x27;s something you&#x27;re curious about right now and would love to learn more about?</li><li>Who was the first friend you remember choosing for yourself, and what drew you to them?</li><li>What&#x27;s a compliment you received that you still think about?</li><li>What&#x27;s a tradition, big or small, that you&#x27;d like to keep for the rest of your life?</li><li>What kind of moments make you lose track of time?</li><li>What&#x27;s something about where you grew up that you only appreciated after you left?</li></ol></details></section><section class="tsq-stage tsq-stage--pink" aria-labelledby="tsq-stage-2"><p class="tsq-stage__eyebrow">Stage 2</p><h3 id="tsq-stage-2" class="tsq-stage__title">Going Deeper</h3><p class="tsq-stage__text">Experiences, values, and memories — the moments and beliefs that have shaped you.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="13"><li>What&#x27;s a decision you made that changed the direction of your life?</li><li>When did you last feel truly proud of yourself, and why did that moment matter?</li><li>Which value do you try hardest to live by, even when it&#x27;s inconvenient?</li><li>What&#x27;s a lesson you learned the hard way that you&#x27;re now grateful for?</li><li>Who taught you the most about how to treat other people, and how did they teach you?</li><li>What&#x27;s something you believed strongly a few years ago that you see differently now?</li><li>What helps you feel at home when you&#x27;re somewhere unfamiliar?</li><li>What&#x27;s a fear you&#x27;ve grown out of, and what helped you move past it?</li><li>When you&#x27;re going through something difficult, what do you most need from the people around you?</li><li>When did a stranger&#x27;s kindness stay with you long after the moment passed?</li><li>What part of your everyday life would you protect no matter how busy you got?</li><li>What do you hope people feel after spending time with you?</li></ol></details></section><section class="tsq-stage tsq-stage--peach" aria-labelledby="tsq-stage-3"><p class="tsq-stage__eyebrow">Stage 3</p><h3 id="tsq-stage-3" class="tsq-stage__title">Growing Closer</h3><p class="tsq-stage__text">Feelings, hopes, and what you see in each other — the questions that ask for a little more openness.</p><details class="tsq-stage__details"><summary class="tsq-stage__summary">See all 12 questions</summary><ol class="tsq-stage__list" start="25"><li>What&#x27;s something you rarely say out loud but often feel?</li><li>When do you feel most like yourself around another person?</li><li>What&#x27;s a part of yourself you&#x27;re still learning to accept?</li><li>What&#x27;s a hope for your future that you don&#x27;t often share?</li><li>How do you usually show someone you care, and how do you most like to be cared for?</li><li>What&#x27;s a question you wish more people asked you?</li><li>What makes it hard for you to let people in, and what makes it easier?</li><li>What does feeling truly understood look like for you?</li><li>When did you last feel really close to someone, and what made it feel that way?</li><li>What&#x27;s something you appreciate about the person you&#x27;re answering these questions with?</li><li>What&#x27;s something you&#x27;d love the two of you to experience together?</li><li>What&#x27;s one thing you&#x27;d like them to know about you that hasn&#x27;t come up yet?</li></ol></details></section></div></section><section class="tsq-cta" aria-labelledby="tsq-cta-heading"><h2 id="tsq-cta-heading" class="tsq-cta__heading">Ready when you are</h2><p class="tsq-cta__text">Answer first, then send the link. You&#x27;ll read each other&#x27;s answers once you&#x27;ve both finished.</p><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="gameId" value="36-questions-to-fall-in-love"/><button type="submit" class="landing-button landing-button--primary landing-button--play">Start the experience <span aria-hidden="true">→</span></button></form></section><section class="tsq-section" aria-labelledby="tsq-faq"><h2 id="tsq-faq" class="tsq-section__heading">Questions people ask</h2><div class="faq-accordion"><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-0"><span class="faq-item__question">Do the 36 questions really make people fall in love?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-0" class="faq-item__answer faq-item__answer--lavender" hidden="">No list of questions can promise that. The original study found that pairs of strangers felt closer after working through its questions than pairs who spent the same time on small talk — it didn&#x27;t test whether anyone fell in love. Think of it as a structured way into a conversation you might not otherwise have.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-1"><span class="faq-item__question">Are these the questions from the original study?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-1" class="faq-item__answer faq-item__answer--lavender" hidden="">No. These are original questions written for Sameeeish, built on the same idea: start light and go a little deeper with each stage. If you&#x27;d like to read the research version, look up Aron and colleagues&#x27; 1997 paper, “The Experimental Generation of Interpersonal Closeness.”</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-2"><span class="faq-item__question">How long does it take?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-2" class="faq-item__answer faq-item__answer--lavender" hidden="">In the original study, pairs had about 45 minutes for all three sets of questions, asked out loud. Writing your answers usually takes a bit longer, so many people spread it over an evening. Your answers save as you go, so you can stop and pick up where you left off on the same browser.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-3"><span class="faq-item__question">Is it only for couples?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-3" class="faq-item__answer faq-item__answer--lavender" hidden="">It sits in our Dating &amp; Couples section and works just as well for a first date as for a long relationship. But the questions suit any two people who want to know each other better, close friends included.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-4"><span class="faq-item__question">Who can see our answers?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-4" class="faq-item__answer faq-item__answer--lavender" hidden="">Only the two of you. Your answers are tied to your private link and the browser you answered on, and neither of you can see the other&#x27;s answers until you&#x27;ve both finished. Nothing you write appears on this page or anywhere public, and there&#x27;s no account to create.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-5"><span class="faq-item__question">Is there a score at the end?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-5" class="faq-item__answer faq-item__answer--lavender" hidden="">No. This isn&#x27;t a compatibility test, so there&#x27;s no percentage, rating, or verdict. What you get is your conversation: both of your answers to every question, side by side.</p></div><div class="faq-item"><button type="button" class="faq-item__row" aria-expanded="false" aria-controls="faq-answer-tsq-6"><span class="faq-item__question">Can we do it together in person?</span><span class="faq-item__toggle" aria-hidden="true">+</span></button><p id="faq-answer-tsq-6" class="faq-item__answer faq-item__answer--lavender" hidden="">Yes. One easy way: each of you answers on your own phone, then sit down together with your finished conversation and go through it question by question, reading your answers out loud and talking about them.</p></div></div></section><nav class="tsq-section tsq-related" aria-labelledby="tsq-related"><h2 id="tsq-related" class="tsq-section__heading">More for the two of you</h2><ul class="tsq-related__list"><li><a class="tsq-related__card tsq-related__card--lavender" href="/play/dating-couples/getting-to-know-each-other-questions"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M14 36c14-18 28-18 34 0s20 18 34 0" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="4 5"></path><circle cx="14" cy="36" r="8" fill="#ffffff" stroke="var(--wl-lavender)" stroke-width="4"></circle><circle cx="14" cy="36" r="3" fill="var(--wl-ink)"></circle><circle cx="82" cy="36" r="8" fill="#ffffff" stroke="var(--wl-blue)" stroke-width="4"></circle><circle cx="82" cy="36" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Discovery &amp; Conversation</span><span class="tsq-related__title">Getting to know each other questions</span><span class="tsq-related__text">Lighter questions for new couples and early dates.</span><span class="tsq-related__go">Explore <span aria-hidden="true">→</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--peach" href="/play/dating-couples/date-night"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" fill="#ffffff"></path><path d="M50 8a20 20 0 1 0 14 34A16 16 0 0 1 50 8z" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></path><path d="M72 12l1.5 3.5 3.5 1.5-3.5 1.5L72 22l-1.5-3.5L67 17l3.5-1.5z" fill="var(--wl-pink)"></path><path d="M80 30l1 2.4 2.4 1-2.4 1-1 2.4-1-2.4-2.4-1 2.4-1z" fill="var(--wl-ink)" opacity="0.5"></path><circle cx="20" cy="18" r="2" fill="var(--wl-pink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Conversation Starters</span><span class="tsq-related__title">Date Night</span><span class="tsq-related__text">Conversation starters to pick from, one at a time.</span><span class="tsq-related__go">Explore <span aria-hidden="true">→</span></span></span></a></li><li><a class="tsq-related__card tsq-related__card--mint" href="/play/dating-couples"><span class="tsq-related__art" aria-hidden="true"><svg viewBox="0 0 96 56" fill="none"><circle cx="38" cy="28" r="18" fill="#ffffff" fill-opacity="0.7"></circle><circle cx="58" cy="28" r="18" fill="var(--wl-blue)" fill-opacity="0.75"></circle><circle cx="38" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="58" cy="28" r="18" stroke="var(--wl-ink)" stroke-opacity="0.35" stroke-width="1.5"></circle><circle cx="48" cy="28" r="3" fill="var(--wl-ink)"></circle></svg></span><span class="tsq-related__body"><span class="tsq-related__eyebrow">Compatibility Quiz</span><span class="tsq-related__title">Are we on the same page?</span><span class="tsq-related__text">A compatibility quiz to see where you align — and every other couples experience.</span><span class="tsq-related__go">Explore <span aria-hidden="true">→</span></span></span></a></li></ul></nav></article></main><footer class="landing-footer"><div class="landing-footer__top"><div class="landing-footer__brand"><a class="landing-logo landing-logo--footer" href="/"><svg class="landing-logo__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true"><defs><linearGradient id="_R_an_" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="var(--wl-lavender)"></stop><stop offset="100%" stop-color="var(--wl-blue)"></stop></linearGradient></defs><circle class="logo-mark__ping" cx="12" cy="12" r="9" stroke="url(#_R_an_)" stroke-width="1.5"></circle><circle cx="12" cy="12" r="9" stroke="url(#_R_an_)" stroke-width="2.25"></circle><circle cx="12" cy="12" r="3.75" fill="currentColor"></circle></svg><span>Sameeeish</span></a><p class="landing-footer__description">A playful way to see how aligned you are with someone, through questions and shared answers.</p></div><nav class="landing-footer__col" aria-label="Explore"><p class="landing-footer__heading">Explore</p><a class="landing-footer__link" href="/ways-to-play">Ways to play</a><a class="landing-footer__link" href="/play">Let&#x27;s play</a><a class="landing-footer__link" href="/how-it-works">How it works</a></nav><nav class="landing-footer__col" aria-label="Information"><p class="landing-footer__heading">Information</p><a class="landing-footer__link" href="/about">About</a><a class="landing-footer__link" href="/privacy">Privacy</a><a class="landing-footer__link" href="/terms">Terms</a><a class="landing-footer__link" href="/contact">Contact</a></nav></div><p class="landing-footer__copy">© 2026 Sameeeish. Made with care.</p></footer></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var c=a.target,d=a.submitter,e=c.action,b=d;if(d){var f=d.getAttribute("formAction");null!=f&&(e=f,b=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===e&&(a.preventDefault(),b?(a=